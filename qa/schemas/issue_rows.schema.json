{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "issue_rows.schema.json",
  "title": "Structured Issue Rows CSV",
  "type": "object",
  "required": ["columns", "rows"],
  "properties": {
    "columns": {
      "type": "array",
      "prefixItems": [
        {"const": "row"},
        {"const": "field"},
        {"const": "value"},
        {"const": "issue_type"},
        {"const": "reason"}
      ],
      "minItems": 5
    },
    "rows": {
      "type": "array",
      "items": {"$ref": "#/$defs/row"}
    }
  },
  "$defs": {
    "row": {
      "type": "object",
      "required": ["row", "field", "value", "issue_type", "reason"],
      "properties": {
        "row": {"type": ["integer", "string"]},
        "field": {"type": "string"},
        "value": {"type": ["string", "number", "boolean", "null"]},
        "issue_type": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}

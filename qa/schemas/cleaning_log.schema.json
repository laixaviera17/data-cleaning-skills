{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cleaning_log.schema.json",
  "title": "Cleaning Operation Log CSV",
  "type": "object",
  "required": ["columns", "rows"],
  "properties": {
    "columns": {
      "type": "array",
      "prefixItems": [
        {"const": "timestamp"},
        {"const": "step"},
        {"const": "rule_name"},
        {"const": "action"},
        {"const": "affected_rows"},
        {"const": "result"},
        {"const": "message"}
      ],
      "minItems": 7
    },
    "rows": {
      "type": "array",
      "items": {"$ref": "#/$defs/row"}
    }
  },
  "$defs": {
    "row": {
      "type": "object",
      "required": ["timestamp", "step", "rule_name", "action", "affected_rows", "result", "message", "run_id"],
      "properties": {
        "timestamp": {"type": "string", "minLength": 1},
        "step": {"type": "string", "minLength": 1},
        "rule_name": {"type": "string", "minLength": 1},
        "action": {"type": "string", "minLength": 1},
        "affected_rows": {"type": "integer", "minimum": 0},
        "result": {"type": "string", "enum": ["success", "warning", "failed", "skipped"]},
        "message": {"type": "string"},
        "run_id": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
